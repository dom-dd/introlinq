{
  "cleanUrls": true,
  "redirects": [
    { "source": "/detailed", "destination": "/", "permanent": true },
    { "source": "/detailed.html", "destination": "/", "permanent": true },
    { "source": "/landing", "destination": "/", "permanent": true },
    { "source": "/landing.html", "destination": "/", "permanent": true },
    { "source": "/short", "destination": "/", "permanent": true },
    { "source": "/short.html", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/brief", "destination": "/api/admin?resource=brief" },
    { "source": "/blog", "destination": "/api/blog" },
    { "source": "/blog/:slug", "destination": "/api/blog?slug=:slug" }
  ],
  "crons": [
    {
      "path": "/api/sync/openintro?key=il2026",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/weekly-stats",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/activation-reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/widget-removed-check",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/weekly-blog",
      "schedule": "0 10 * * 3"
    }
  ],
  "functions": {
    "api/admin.js": { "maxDuration": 60 },
    "api/match.js": { "maxDuration": 60 },
    "api/dashboard.js": { "maxDuration": 30 },
    "api/cron/weekly-blog.js": { "maxDuration": 60 },
    "api/blog.js": { "maxDuration": 30, "includeFiles": "partials/**" }
  }
}
